rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------
    // Authorization helpers
    // ----------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isActiveUser() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get(
          "active",
          true
        ) == true;
    }

    function isSystemAdmin() {
      return isActiveUser()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get(
          "systemRole",
          ""
        ) == "system-admin";
    }

    function isSchoolAdmin(schoolId) {
      return isActiveUser()
        && exists(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
        ).data.role == "school-admin"
        && get(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
        ).data.active == true;
    }

    function canAdministerSchool(schoolId) {
      return isSchoolAdmin(schoolId)
        || isSystemAdmin();
    }

    function isActiveSchoolMember(schoolId) {
      return isActiveUser()
        && exists(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
        ).data.active == true;
    }

    function isTeacher(schoolId) {
      return isActiveSchoolMember(schoolId)
        && get(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
        ).data.role == "teacher";
    }

    function isAssignedTeacher(schoolId, classId) {
      return isTeacher(schoolId)
        && exists(
          /databases/$(database)/documents/schools/$(schoolId)/classes/$(classId)
        )
        && request.auth.uid in get(
          /databases/$(database)/documents/schools/$(schoolId)/classes/$(classId)
        ).data.get("teacherUids", []);
    }

    function isAssignedTeacherToClass(schoolId) {
      return isTeacher(schoolId)
        && request.auth.uid in
          resource.data.get("teacherUids", []);
    }

    // ----------------------------------------
    // Users
    // ----------------------------------------

    match /users/{userId} {

      allow read: if signedIn()
                  && (
                    request.auth.uid == userId
                    || isSystemAdmin()
                  );

      // Normal users may edit only their own
      // non-administrative profile fields.
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data
                         .diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           "displayName",
                           "firstName",
                           "lastName",
                           "activeSchool",
                           "updatedAt"
                         ])
                    && (
                      !request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasAny([
                          "activeSchool"
                        ])
                      ||
                      isSystemAdmin()
                      ||
                      isActiveSchoolMember(
                        request.resource.data.activeSchool
                      )
                    );

      // System Admin may change system-level
      // administrative fields.
      allow update: if isSystemAdmin()
                    && request.resource.data
                         .diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           "systemRole",
                           "updatedAt"
                         ]);

      // User creation is handled by Cloud Functions.
      allow create, delete: if false;
    }

    // ----------------------------------------
    // Schools
    // ----------------------------------------

    match /schools/{schoolId} {

      allow read: if isSystemAdmin()
                  || isActiveSchoolMember(
                    schoolId
                  );

      allow create, update, delete:
        if isSystemAdmin();

      // --------------------------------------
      // Students
      // --------------------------------------

      match /students/{studentId} {
        allow read:
          if canAdministerSchool(schoolId)
            || (
              isActiveSchoolMember(schoolId)
              && get(
                /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
              ).data.role == "teacher"
            );

        allow create, delete:
          if canAdministerSchool(schoolId);

        allow update:
          if canAdministerSchool(schoolId)
            || (
              isActiveSchoolMember(schoolId)
              && get(
                /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
              ).data.role == "teacher"
            );
      }

      // --------------------------------------
      // Buildings
      // --------------------------------------

      match /buildings/{buildingId} {
        allow read, write:
          if canAdministerSchool(schoolId);
      }

      // --------------------------------------
      // Rooms
      // --------------------------------------

      match /rooms/{roomId} {
        allow read:
          if canAdministerSchool(schoolId)
            || isTeacher(schoolId);

        allow create, update, delete:
          if canAdministerSchool(schoolId);
      }

      // --------------------------------------
      // Courses
      // --------------------------------------

      match /courses/{courseId} {
        allow read, write:
          if canAdministerSchool(schoolId);
      }

      // --------------------------------------
      // Classes
      // --------------------------------------

      match /classes/{classId} {
        allow read:
          if canAdministerSchool(schoolId)
            || isAssignedTeacherToClass(schoolId);

        allow create, delete:
          if canAdministerSchool(schoolId);

        allow update:
          if canAdministerSchool(schoolId)
            || (
              isAssignedTeacherToClass(schoolId)

              // Teachers cannot assign/remove teachers.
              && request.resource.data.get("teacherUids", [])
                == resource.data.get("teacherUids", [])

              && request.resource.data.get("mainTeacherUid", "")
                == resource.data.get("mainTeacherUid", "")

              // Teachers cannot archive/reactivate classes.
              && request.resource.data.get("active", true)
                == resource.data.get("active", true)
            );

        match /enrollments/{enrollmentId} {

          allow read:
            if canAdministerSchool(schoolId)
              || isAssignedTeacher(schoolId, classId);

          allow create, update, delete:
            if canAdministerSchool(schoolId);
        }

        match /seatingPlans/{seatingPlanId} {

          allow read, write:
            if canAdministerSchool(schoolId)
              || isAssignedTeacher(schoolId, classId);
        }
      }

      // --------------------------------------
      // School memberships
      // --------------------------------------

      match /members/{memberId} {

        allow read: if signedIn()
                    && (
                      request.auth.uid
                        == memberId
                      || canAdministerSchool(
                        schoolId
                      )
                    );

        allow create:
          if canAdministerSchool(
            schoolId
          )
          && request.resource.data.userUid
            == memberId;

        allow update:
          if (
            isSystemAdmin()
            || (
              canAdministerSchool(
                schoolId
              )
              && request.auth.uid
                != memberId
            )
          )
          && request.resource.data.userUid
            == resource.data.userUid
          && request.resource.data.userUid
            == memberId;

        allow delete:
          if isSystemAdmin()
            || (
              canAdministerSchool(
                schoolId
              )
              && request.auth.uid
                != memberId
            );
      }

      // --------------------------------------
      // School activity logs
      // --------------------------------------

      match /auditLogs/{logId} {

        allow read:
          if canAdministerSchool(
            schoolId
          );

        // Some current audit events are written
        // directly by the client together with
        // the school operation.
        allow create:
          if canAdministerSchool(
            schoolId
          );

        // Audit history is immutable.
        allow update, delete:
          if false;
      }
    }

    // ----------------------------------------
    // System activity logs
    // ----------------------------------------

    match /systemAuditLogs/{logId} {

      // Only active System Admins can see global
      // system-level audit history.
      allow read:
        if isSystemAdmin();

      // These records are created by trusted
      // Cloud Functions using the Admin SDK.
      allow create, update, delete:
        if false;
    }

    // ----------------------------------------
    // Collection-group access for memberships
    // ----------------------------------------

    match /{path=**}/members/{memberId} {

      allow read: if isActiveUser()
                  && (
                    resource.data.userUid
                      == request.auth.uid
                    || isSystemAdmin()
                  );
    }

    // ----------------------------------------
    // Legacy artifacts
    // ----------------------------------------

    match /artifacts/{appId}/students/{studentId} {
      allow read, write:
        if isActiveUser();
    }

    match /artifacts/{appId}/classrooms/{classroomId} {
      allow read, write:
        if isActiveUser();
    }
  }
}